{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "划词翻译(免费)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "languages.js",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://fanyi.sogou.com/*",
    "https://m.youdao.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "permissions": [
    "storage"
  ],
  "version": "1.0.34"
}
